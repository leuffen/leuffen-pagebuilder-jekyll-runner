{
  "name": "leuffen/leuffen-pagebuilder-preview",
  "description": "RabbitMQ preview worker and Apache CDN backed by an external HTTP builder",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-pcntl": "*",
    "ext-zip": "*",
    "php-amqplib/php-amqplib": "^3.7",
    "phore/log": "dev-master",
    "phore/http-client": "dev-main",
    "leuffen/leuffen-jekyll-builder": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Leuffen\\PagebuilderPreview\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/leuffen/leuffen-jekyll-builder"
    }
  ],
  "config": {
    "preferred-install": "dist",
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
