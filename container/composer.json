{
  "name": "leuffen/pagebuilder-preview-server",
  "description": "RabbitMQ preview worker and Apache CDN using the external Jekyll Builder",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-pcntl": "*",
    "ext-zip": "*",
    "php-amqplib/php-amqplib": "^3.7",
    "phore/log": "dev-master",
    "leuffen/jekyll-builder-client": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "Leuffen\\PagebuilderPreview\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
